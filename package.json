{
  "name": "iribatech",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "node api.js && pnpm --parallel --filter @iribatech/api --filter @iribatech/web dev",
    "build": "node api.js && pnpm -r --if-present build",
    "db:migrate": "pnpm --filter @iribatech/api migrate",
    "db:migrate:make": "pnpm --filter @iribatech/api migrate:make",
    "db:seed": "pnpm --filter @iribatech/api seed",
    "db:rollback": "pnpm --filter @iribatech/api migrate:rollback"
  }
}
